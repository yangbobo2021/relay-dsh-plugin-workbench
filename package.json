{
  "name": "relay-dsh-plugin-workbench",
  "version": "0.1.0",
  "description": "Extensible workbench shell for DeepSeek Harness with generic side and bottom view registration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangbobo2021/relay-dsh-plugin-workbench.git"
  },
  "homepage": "https://github.com/yangbobo2021/relay-dsh-plugin-workbench#readme",
  "bugs": {
    "url": "https://github.com/yangbobo2021/relay-dsh-plugin-workbench/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/host-plugin.js",
  "engines": { "node": ">=22.13" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "prepare:dsh": "scripts/link-dsh-development-peers.sh",
    "prebuild": "npm run prepare:dsh && node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsdown --config tsdown.config.ts",
    "postbuild": "node normalize-build.mjs",
    "pretypecheck": "npm run prepare:dsh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "exports": {
    ".": "./lib/host-plugin.js",
    "./client": "./lib/client.js",
    "./contracts": {
      "types": "./contracts.d.ts",
      "default": "./contracts.js"
    },
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "files": ["README.md", "README.zh.md", "docs/images", "contracts.d.ts", "contracts.js", "cordis.patch.yml", "lib/client.js", "lib/client.js.map", "lib/host-plugin.js", "lib/host-plugin.js.map", "lib/typert.host.js", "lib/typert.host.js.map"],
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-theme"],
      "platform": "web"
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "lightningcss": "1.32.0",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": { "react": { "optional": true } }
}
